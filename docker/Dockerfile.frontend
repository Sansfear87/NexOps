# Build Stage
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package.json ./
# If package-lock.json exists, npm ci, otherwise npm install
RUN npm install

COPY frontend/ ./
RUN npm run build

# Production Stage
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
