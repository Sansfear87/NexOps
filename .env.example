# ==============================================================================
# AI DevOps Assistant - Environment Configuration
# ==============================================================================
# Phase 0 Foundation: The initial setup uses local PostgreSQL and mock/sandbox endpoints.
# Keys under "Future Integration Placeholders" will be configured in subsequent phases.

# --- Platform & Runtime Environment ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-insecure-secret-key-for-production-min-32-chars
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Backend Service Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend Service Configuration ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- PostgreSQL Relational Database ---
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=devops_password
POSTGRES_DB=devops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devops_user:devops_password@postgres:5432/devops_db
# Direct synchronous URL for Alembic migrations:
SYNC_DATABASE_URL=postgresql://devops_user:devops_password@postgres:5432/devops_db

# ==============================================================================
# FUTURE INTEGRATION PLACEHOLDERS (Unused in Phase 0)
# ==============================================================================

# --- Phase 2: GitHub Integration ---
# GITHUB_APP_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY_PATH=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Phase 8: Deployment Providers ---
# Vercel Adapter:
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Render Adapter:
# RENDER_API_KEY=
# RENDER_SERVICE_ID=

# --- Phase 5: Agent Runtime (DeepSeek) ---
# Get your API key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# --- Phase 12: Nebius AI Cloud & Models ---
# Nebius AI Cloud GPU Serving:
# NEBIUS_API_KEY=
# NEBIUS_TENANT_ID=
# NEBIUS_ENDPOINT_URL=

# NVIDIA Nemotron (for complex reasoning):
# NVIDIA_NEMOTRON_API_KEY=
