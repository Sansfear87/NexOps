# -----------------------------------------------------------------------------
# AI DevOps Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# -----------------------------------------------------------------------------

# --- Platform & Security ---
APP_ENV=development
SECRET_KEY=change-this-in-production-to-a-very-long-random-string-at-least-32-chars
PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devops_assistant
# Sync URL used by Alembic migrations:
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/devops_assistant

# --- GitHub Integration (Phase 2) ---
# Create a GitHub App or Personal Access Token with repo scope:
GITHUB_TOKEN=your-github-personal-access-token-here
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
# Optional: GitHub App credentials (if using App authentication)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_INSTALLATION_ID=

# --- Cloud Deployment Providers (Phase 8) ---
# Vercel:
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# Render:
# RENDER_API_KEY=
# RENDER_SERVICE_ID=

# --- Nebius AI Cloud Token Factory (Phases 5, 12, Multi-Agent) ---
# Nebius Token Factory OpenAI-compatible endpoint:
NEBIUS_API_BASE=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=your-nebius-token-factory-key-here

# Supported Models on Nebius Token Factory:
# 1. Fast Reasoning / Planning: nvidia/Nemotron-3_5-Lightning
# 2. Vision / Incident Diagnostics: nvidia/Nemotron-3.5-Super-VL
# 3. High-Throughput Coder: deepseek-ai/DeepSeek-V4.1-Flash-1017
# 4. Deep PR Review & Architecture: deepseek-ai/DeepSeek-V4-Pro-0813
PREFERRED_FAST_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
PREFERRED_REASONING_MODEL=nvidia/Nemotron-3_5-Lightning

# --- DeepSeek Direct API (Optional Alternative) ---
# Get your API key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here
